{
  "name": "golf-scorer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev ./public --compatibility-date=2024-09-23 --port 8788",
    "dev:full": "concurrently \"wrangler pages dev ./public --compatibility-date=2024-09-23 --port 8788\" \"echo 'Dev server started'\"",
    "build": "tsc && cp -r public/* dist/",
    "build:worker": "esbuild src/index.tsx --bundle --outfile=dist/_worker.js --format=esm --target=es2022",
    "build:all": "npm run build:worker && mkdir -p dist && cp -r public/. dist/",
    "deploy": "npm run build:all && wrangler pages deploy dist --project-name=golf-scorer",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.88.0"
  }
}
